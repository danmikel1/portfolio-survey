# ==============================================================================
# Portfolio Survey SaaS — Environment Template
# Copy to .env for local development. NEVER commit real secrets to Git.
# Generate strong hex values with: openssl rand -hex 32
# ==============================================================================

# Application
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SURVEY_VERSION=v1.0.0

# PostgreSQL (hex password avoids URL-encoding issues in DATABASE_URL)
POSTGRES_USER=survey_app
POSTGRES_PASSWORD=replace_with_64_char_hex_password
POSTGRES_DB=portfolio_survey
DATABASE_URL=postgresql://survey_app:replace_with_64_char_hex_password@localhost:5432/portfolio_survey?schema=public

# Admin Authentication (store Argon2id/bcrypt hash, never plaintext)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_argon2id_or_bcrypt_hash
ADMIN_SESSION_SECRET=replace_with_64_char_hex_secret

# Cloudflare Turnstile (spam / bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_key

# Cloudflare Tunnel (used by deployment/compose.yaml on TrueNAS)
CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token
